# Asset Management System — development environment
#
# Copy to `.env` and adjust. `.env` is git-ignored and MUST NOT be committed
# (05-infrastructure.md §9.2). Production values live in GitLab CI/CD variables.
#
# Variable naming follows 05-infrastructure.md §1.2 (UPPER_SNAKE_CASE). The API
# fails fast at startup when a required variable is missing (§1.2).

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Datastores --------------------------------------------------------------
# Host values. Inside Docker Compose the api service overrides these to use the
# `postgres` / `redis` service hostnames (see docker-compose.dev.yml).
#
# The port in DATABASE_URL must match POSTGRES_PORT below, and REDIS_URL must
# match REDIS_PORT.
DATABASE_URL=postgres://asset_app:asset_app_dev@localhost:5432/asset_management
REDIS_URL=redis://localhost:6379

# Database used by the schema verification suite (`npm run test:db`). It is
# created on demand and its schemas are dropped and rebuilt on every run, so it
# MUST NOT point at the development database.
TEST_DATABASE_URL=postgres://asset_app:asset_app_dev@localhost:5432/asset_management_test

# Host ports the containers publish to. Change these when something else already
# occupies the default — a native PostgreSQL service bound to 0.0.0.0:5432 will
# silently shadow the container's mapping and produce an authentication failure
# that looks like a wrong password.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Credentials used to initialise the Postgres container. DATABASE_URL above must
# stay consistent with these three values.
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=asset_app_dev
POSTGRES_DB=asset_management

# --- File storage (05-infrastructure.md §5) ----------------------------------
STORAGE_PATH=./storage/attachments
MAX_UPLOAD_SIZE_MB=10

# --- HTTP --------------------------------------------------------------------
# Deployed frontend origin. Never `*` (05-infrastructure.md §12.3).
CORS_ORIGIN=http://localhost:5173

# --- Authentication (05-infrastructure.md §6) --------------------------------
# REQUIRED. The API refuses to start without both secrets, and refuses to start
# if they are equal — a shared secret would let a refresh token be presented as
# an access token. Minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access tokens are short-lived and sent as `Authorization: Bearer`; refresh
# tokens are long-lived and delivered as an httpOnly cookie (§6.1).
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Login-specific rate limit (§12.3). Deliberately far stricter than the global
# ceiling — this is the control that makes password guessing impractical.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Refresh is spent once per page load and is authenticated by a signed cookie,
# not a guessable secret — so it gets its own, far looser ceiling than login.
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=120

# --- Background jobs (05-infrastructure.md §7) -------------------------------
# The BullMQ worker runs inside the API process (§7.3) and shares REDIS_URL with
# session storage. Leave enabled: this is what actually writes `OVERDUE` onto a
# borrowing whose expected return date has passed (REQ-BORROW-012). Set to
# `false` only for a process that must not run jobs, such as a one-off CLI.
JOBS_ENABLED=true

# How often the borrowing overdue sweep runs. 15 minutes, per §7.2.
OVERDUE_SWEEP_INTERVAL_MS=900000

# --- Business calendar (05-infrastructure.md §7.5) ----------------------------
# The zone the institution's calendar month is expressed in (CR-012,
# REQ-COND-006). UTC month boundaries fall at 07:00 local in Jakarta, which
# would file the first seven hours of every month into the previous one.
# Must be an IANA zone the runtime recognizes; the API refuses to start if not.
BUSINESS_TIMEZONE=Asia/Jakarta

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
