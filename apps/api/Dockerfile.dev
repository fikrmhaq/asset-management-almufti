# Development image only — hot reload via nodemon and a bind-mounted source tree.
# The production build is Phase 16 (IMPLEMENTATION_PLAN.md §22.8).
FROM node:22-alpine

WORKDIR /app

# Install against the workspace manifests first so dependency layers stay cached
# when only application source changes.
COPY package.json package-lock.json* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm install --workspace apps/api --include-workspace-root

COPY apps/api ./apps/api

EXPOSE 3000

CMD ["npm", "run", "dev", "--workspace", "apps/api"]
