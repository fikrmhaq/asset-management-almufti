# Development image only — Vite dev server with hot module replacement.
# The production static build served by Nginx is Phase 16.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm install --workspace apps/web --include-workspace-root

COPY apps/web ./apps/web

EXPOSE 5173

# --host binds 0.0.0.0 so the port is reachable from outside the container.
CMD ["npm", "run", "dev", "--workspace", "apps/web", "--", "--host"]
