# On-premises deployment configuration.
#
# Copy to `.env` NEXT TO docker-compose.prod.yml — Docker Compose reads it
# automatically from the directory it runs in. Never commit the filled copy:
# it holds the database password and both signing secrets.
#
#   cp .env.example .env && chmod 600 .env
#
# Every variable without a default is required. The API validates its whole
# configuration at boot and exits listing EVERY problem at once, so a
# misconfigured deployment is fixed in one pass rather than one restart at a
# time. If the container exits immediately, read the log — it names the
# variable.

# --- Images -------------------------------------------------------------------
# The tags `scripts/build-images.sh` produces. Defaults in the compose file
# already match these, so leave them unless you retagged the images.
API_IMAGE=asset-management/api:1.0.0
WEB_IMAGE=asset-management/web:1.0.0

# --- Database -----------------------------------------------------------------
# DATABASE_URL must stay consistent with the three POSTGRES_* values. The host
# is `postgres` — the compose SERVICE name, not localhost: `localhost` inside
# the api container means the api container itself.
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=
POSTGRES_DB=asset_management
DATABASE_URL=postgres://asset_app:CHANGE_ME@postgres:5432/asset_management

# --- Redis --------------------------------------------------------------------
# Holds refresh-token sessions (§6.2) and the job queue (§7.3). Same reasoning
# on the hostname.
REDIS_URL=redis://redis:6379

# --- Secrets ------------------------------------------------------------------
# REQUIRED, minimum 32 characters, and they MUST DIFFER from each other — a
# shared secret would let a refresh token be presented as an access token, and
# the API refuses to start if they match. Generate two:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Or without Node on the server:
#
#   openssl rand -base64 48 | tr -d '\n=+/' 
#
# Changing either one signs every user out. That is the intended way to revoke
# every session at once.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- The origin browsers use --------------------------------------------------
# EXACT origin: scheme, host, and port if it is not 443. No trailing slash.
# A wildcard is refused by the config (§12.3).
#
#   https://assets.example.local          <- standard port
#   https://assets.example.local:8443     <- if 443 is unavailable
#   https://192.168.1.50                  <- if there is no internal DNS name
#
# It MUST be https. The refresh cookie is `Secure` in production, and a browser
# silently drops such a cookie on a plain http:// origin — login then appears to
# work while every page reload returns the user to the login screen.
CORS_ORIGIN=https://assets.example.local

# --- Host paths ---------------------------------------------------------------
# Attachments. Bind-mounted at /storage, and the mount HIDES the ownership the
# image sets, so this directory must be owned by uid 1000:
#
#   sudo mkdir -p /srv/asset-management/storage
#   sudo chown -R 1000:1000 /srv/asset-management/storage
#
# A redeploy must never touch it (§5.2).
STORAGE_DIR=/srv/asset-management/storage

# Nightly backups (scripts/backup.sh). 14 daily + 4 weekly are kept here.
BACKUP_DIR=/var/backups/asset-management

# A SECOND disk, NAS mount or remote host that backups are copied to. The
# database, its backups and every attachment otherwise share one disk, so a
# single failure destroys all three at the same moment. Leave empty only if
# BACKUP_RSYNC_TARGET below is set instead.
BACKUP_MIRROR_DIR=

# Or an rsync/ssh destination, if the copy goes to another machine:
#   BACKUP_RSYNC_TARGET=backup@192.168.1.60:/srv/backups/asset-management
BACKUP_RSYNC_TARGET=

# --- Ports --------------------------------------------------------------------
# The web container publishes here on LOOPBACK ONLY; the TLS front proxies to
# it. If you change this, change nginx/site.conf's proxy_pass to match.
WEB_PORT=8080

# --- Optional: the containerised TLS front (docker-compose.tls.yml) -----------
# Only needed if you use that overlay instead of host Nginx. The directory must
# contain `server.crt` and `server.key` from scripts/make-cert.sh.
CERT_DIR=/srv/asset-management/certs
HTTP_PORT=80
HTTPS_PORT=443

# --- Application defaults -----------------------------------------------------
# Rarely changed. MAX_UPLOAD_SIZE_MB above 10 also needs client_max_body_size
# raised in the Nginx configs, which are set to 12m.
MAX_UPLOAD_SIZE_MB=10

# The zone the institution's calendar month is expressed in (CR-012). Must be an
# IANA zone the runtime recognises; the API refuses to start otherwise.
BUSINESS_TIMEZONE=Asia/Jakarta

# Runs the borrowing overdue sweep in the API process (REQ-BORROW-012). Leaving
# this off silently stops OVERDUE from ever being written.
JOBS_ENABLED=true
